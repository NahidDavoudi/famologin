APP_MODE=development
PUBLIC_URL=http://localhost/famo/v3.10.1/public
ADMIN_URL=http://localhost/famo/v3.10.1/admin
DASHBOARD_URL=http://localhost/famo/v3.10.1/dashboard
LOGIN_URL=http://localhost/famo/v3.10.1/login
ASSET_URL=https://assets.famoacademy.ir
API_URL=https://api.famoacademy.ir

# Telegram Login Widget bot username WITHOUT the leading @ (e.g. FamoAcademyBot).
# In @BotFather run /setdomain and register the exact HTTPS site host that serves
# this login page. The domain must be HTTPS and one domain per bot is allowed; a
# domain mismatch makes verify fail with TELEGRAM_AUTH_INVALID.
TELEGRAM_BOT_USERNAME=

# The widget bot above, the bot host bot, and the API's derived key
# TELEGRAM_LOGIN_SECRET_KEY must ALL belong to the SAME bot.
# The API stores the derived hex only, never the bot token. Compute it locally and
# set the result as TELEGRAM_LOGIN_SECRET_KEY in the API .env:
#   php -r "echo hash('sha256', '<BOT_TOKEN>');"

# Bot-side setting (configured on the bot host, not needed by this page): the
# fixed login URL the bot shows to users. The source=telegram param makes the
# page render the widget and skip the auto-redirect for already-logged-in users.
# BOT_LOGIN_URL=https://<site-host>/login?source=telegram
