                  - type: object
                    properties:
                      data:
                        $ref: "#/components/schemas/PublicTestimonialSubmitResponse"
        "409":
          description: Duplicate submission detected within the 10-minute Redis deduplication window (`DUPLICATE_TESTIMONIAL`)
          $ref: "#/components/responses/Conflict"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

