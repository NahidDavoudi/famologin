                  type: string
                  enum: [unpaid, paid, pending, exempt, partial]
                  description: وضعیت پرداخت اولیه شهریه
                tuition_due_date:
                  type: string
                  format: date
                  description: تاریخ سررسید شهریه (YYYY-MM-DD)
