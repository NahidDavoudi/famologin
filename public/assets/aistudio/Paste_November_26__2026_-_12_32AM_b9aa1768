  /api/v1/public/exam-results/{token}:
    get:
      tags: [Public, Exams]
      summary: View shared exam result by token (unauthenticated parent view)
      description: |
        Returns a student's exam result breakdown, average percentage, and teacher/staff comments
        for a valid, unrevoked, non-expired share token.
        - **Security & Privacy**:
          - Only SHA-256 (`token_hash`) is stored in MySQL (`exam_result_links`), with a 14-day TTL.
          - Response excludes `national_id` and `phone`.
          - Exempt from `PublicCacheMiddleware`; emits `Cache-Control: no-store, no-cache, must-revalidate`, `X-Robots-Tag: noindex, nofollow`, and `Referrer-Policy: no-referrer`.
          - Stricter IP rate limit (`20` requests per `60` seconds).
          - Links are multi-use within their 14-day TTL; invalid, expired, or revoked tokens always return an identical `404 NOT_FOUND` response.
      operationId: publicGetSharedExamResult
      parameters:
        - name: token
          in: path
          required: true
          description: 43-character base64url token generated from `random_bytes(32)`
          schema:
            type: string
            pattern: "^[A-Za-z0-9_-]{32,64}$"
      responses:
        "200":
          description: Shared exam result details (privacy-safe)
          headers:
            Cache-Control:
              description: Prevents caching of sensitive exam results
              schema:
                type: string
                example: "no-store, no-cache, must-revalidate"
            X-Robots-Tag:
              description: Prevents search engine indexing of shared links
              schema:
                type: string
                example: "noindex, nofollow"
            Referrer-Policy:
              description: Prevents token leakage in HTTP Referer headers
              schema:
                type: string
                example: "no-referrer"
            X-RateLimit-Limit:
              $ref: "#/components/headers/XRateLimitLimitHeader"
            X-RateLimit-Remaining:
              $ref: "#/components/headers/XRateLimitRemainingHeader"
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/PublicSharedExamResult"
        "404":
          description: Uniform 404 for invalid, expired, or revoked token
          headers:
            Cache-Control:
              schema:
                type: string
                example: "no-store, no-cache, must-revalidate"
            X-Robots-Tag:
              schema:
                type: string
                example: "noindex, nofollow"
            Referrer-Policy:
              schema:
                type: string
                example: "no-referrer"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                success: false
                data: null
                pagination: null
                error:
                  code: NOT_FOUND
                  message: لینک نتیجه آزمون معتبر نیست یا منقضی شده است
        "429":
          $ref: "#/components/responses/RateLimited"

