openapi: "3.1.0"
info:
  title: Famo Unified API
  description: |
    REST API for Famo Academy — unified backend serving admin panel, public site,
    dashboard, nobat booking, and planner applications.
  version: "1.0.0"
  contact:
    name: Famo Academy
    url: https://famoacademy.ir

servers:
  - url: https://api.famoacademy.ir
    description: Production server

paths:
  # ───────────────────── Health ─────────────────────
  /health:
    get:
      tags: [Health]
      summary: Infrastructure health check (Database & Redis)
      description: Lightweight health endpoint returning live database and Redis connection status for infrastructure monitoring.
      operationId: healthCheckRoot
      responses:
        "200":
          description: Database connection is healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SuccessResponse"
                properties:
                  data:
                    type: object
                    properties:
                      status:
                        type: string
                        enum: [healthy, degraded, unhealthy]
                        example: healthy
                      database:
                        type: object
                        properties:
                          status:
                            type: string
                            enum: [connected, disconnected]
                            example: connected
                          connected:
                            type: boolean
                            example: true
                          latency_ms:
                            type: number
                            example: 0.42
                        required: [status, connected, latency_ms]
                      redis:
                        type: object
                        properties:
                          status:
                            type: string
                            enum: [connected, disconnected, disabled]
                            example: connected
                          connected:
                            type: boolean
                            example: true
                          latency_ms:
                            type: number
                            example: 0.18
                        required: [status, connected, latency_ms]
                      version:
                        type: string
                        example: 1.0.0
                      time:
                        type: string
                        format: date-time
                        example: "2026-10-31 12:00:00"
                    required: [status, database, redis, version, time]
                required: [success, data, pagination, error]
        "503":
          description: Service unavailable (Database is disconnected)

  /api/v1/health:
    get:
      tags: [Health]
      summary: Health check
      operationId: healthCheck
      responses:
        "200":
          description: Service is healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SuccessResponse"
                properties:
                  data:
                    type: object
                    properties:
                      status:
                        type: string
                        enum: [healthy, degraded, unhealthy]
                        example: healthy
                      database:
                        type: object
                        properties:
                          status:
                            type: string
                            enum: [connected, disconnected]
                            example: connected
                          connected:
                            type: boolean
                            example: true
                          latency_ms:
                            type: number
                            example: 0.42
                        required: [status, connected, latency_ms]
                      redis:
                        type: object
                        properties:
                          status:
                            type: string
                            enum: [connected, disconnected, disabled]
                            example: connected
                          connected:
                            type: boolean
                            example: true
                          latency_ms:
                            type: number
                            example: 0.18
                        required: [status, connected, latency_ms]
                      version:
                        type: string
                        example: 1.0.0
                      time:
                        type: string
                        format: date-time
                        example: "2026-09-23 12:00:00"
                    required: [status, database, redis, version, time]
                required: [success, data, pagination, error]
        "503":
          description: Service unavailable (Database is disconnected)

  # ───────────────────── Auth ─────────────────────
  /api/v1/auth/login:
    post:
      tags: [Auth]
      summary: Login
      operationId: authLogin
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                username:
                  type: string
                  description: نام کاربری
                password:
                  type: string
                  description: رمز عبور
              required: [username, password]
      responses:
        "200":
          description: Login successful (student)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          token:
                            type: string
                          user_id:
                            type: integer
                            description: شناسه کاربر
                          phone_mask:
                            type: string
                            nullable: true
                            description: شماره موبایل ماسک شده (در صورت فعال بودن 2FA)
                          user:
                            type: object
                            properties:
                              id:
                                type: integer
                              username:
                                type: string
                              phone:
                                type: string
                                nullable: true
                              role:
                                type: string
                                enum: [admin, supporter, student, teacher]
                              student_id:
                                type: integer
                                nullable: true
                                description: شناسه دانش‌آموز متصل (فقط برای نقش student)
        "202":
          description: >
            2FA required. Admins use the configurable multi-channel fallback chain
            `ADMIN_2FA_CHAIN` (default `sms,email,totp`): SMS OTP (skipped immediately when
            `ADMIN_SMS_ENABLED=false` or when the 3-failure / 10-minute SMS circuit breaker is open,
            4s hard timeout) -> Email OTP via SMTP (8s hard timeout, same OTP) -> Authenticator app
            TOTP (RFC 6238, SHA1, 6 digits, 30s, ±1 drift). Supporters and teachers use SMS OTP;
            students use SMS OTP according to `STUDENT_2FA_MODE=off|new_device|always`.
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          requires_2fa:
                            type: boolean
                            enum: [true]
                          two_fa_method:
                            type: string
                            enum: [sms, email, totp]
                            description: کانال فعال احراز هویت دو مرحله‌ای (sms، email یا totp)
                          channel:
                            type: string
                            enum: [sms, email, totp]
                            description: کانال فعال تحویل کد برای مدیر
                          channel_message:
                            type: string
                            example: Code sent via email
                            description: پیام انگلیسی کانال فعال ("Code sent via SMS" / "Code sent via email" / "Enter the code from your authenticator app")
                          channel_message_fa:
                            type: string
                            description: پیام فارسی کانال فعال
                          destination_mask:
                            type: string
                            nullable: true
                            description: مقصد ماسک‌شده (موبایل یا ایمیل)؛ برای حالت totp مقدار null
                          user_id:
                            type: integer
                            description: شناسه کاربر برای مرحله دوم ورود
                          username:
                            type: string
                            description: نام کاربری
                          role:
                            type: string
                            enum: [admin, supporter, student, teacher]
                          phone_mask:
                            type: string
                            nullable: true
                            description: شماره موبایل ماسک شده کاربر (در صورت ارسال پیامک)
                          email_mask:
                            type: string
                            nullable: true
                            description: آدرس ایمیل ماسک شده کاربر (در صورت ارسال ایمیل)
                          challenge_token:
                            type: string
                            nullable: true
                            description: توکن چالش مرحله اول متصل به نشست ورود (مورد نیاز برای verify-2fa، resend و switch-channel)
                          expires_in:
                            type: integer
                            example: 300
                            description: مدت اعتبار کد به ثانیه (پیش‌فرض ۵ دقیقه)
                          resend_cooldown_seconds:
                            type: integer
                            example: 60
                            description: زمان انتظار تا ارسال مجدد کد (۶۰ ثانیه)
                          sends_used:
                            type: integer
                            example: 1
                          max_sends:
                            type: integer
                            example: 3
                          sends_remaining:
                            type: integer
                            example: 2
                          available_channels:
                            type: array
                            items:
                              type: string
                              enum: [sms, email, totp]
                          secondary_actions:
                            type: object
                            properties:
                              resend_current:
                                type: boolean
                              send_via_email:
                                type: boolean
                              use_authenticator:
                                type: boolean
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: OTP verification service unavailable (Redis offline while student 2FA is active)

  /api/v1/auth/verify-2fa:
    post:
      tags: [Auth]
      summary: Verify 2FA code and complete login
      description: >
        Verifies the second authentication factor and issues a fresh session JWT with
        `two_fa_verified: true`. For admins, verifies the sent 6-digit OTP (SMS or Email, salted
        HMAC-SHA256 hash, constant-time comparison, 5-minute TTL, single-use), a 6-digit RFC 6238
        TOTP code (SHA1, 30s period, ±1 step window with replay protection), or a single-use
        recovery code depending on the active/selected channel. Rate-limited to 5 failed attempts
        per 10 minutes per account and per IP.
      operationId: authVerify2fa
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                user_id:
                  type: integer
                  description: شناسه کاربر برگشتی از مرحله اول ورود
                code:
                  type: string
                  description: کد ۶ رقمی پیامک/ایمیل/TOTP یا یکی از کدهای بازیابی یک‌بارمصرف
                challenge_token:
                  type: string
                  description: توکن چالش برگشتی از مرحله اول ورود
                method:
                  type: string
                  enum: [sms, email, totp, recovery]
                  description: روش اختیاری تایید (مثلاً totp یا recovery)
              required: [user_id, code]
      responses:
        "200":
          description: 2FA verified, login successful
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          token:
                            type: string
                          auth_method:
                            type: string
                            enum: [sms, email, totp, recovery]
                            description: روش استفاده‌شده در تایید دومرحله‌ای
                          remaining_recovery_codes:
                            type: integer
                            nullable: true
                            description: تعداد کدهای بازیابی باقی‌مانده (فقط در صورت ورود با کد بازیابی)
                          user:
                            type: object
                            properties:
                              id:
                                type: integer
                              username:
                                type: string
                              role:
                                type: string
                                enum: [admin, supporter, student, teacher]
                              student_id:
                                type: integer
                                nullable: true
                                description: شناسه دانش‌آموز متصل (فقط برای نقش student)
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: OTP verification service unavailable (fail-closed when Redis is down)

  /api/v1/auth/2fa/resend:
    post:
      tags: [Auth]
      summary: Resend admin 2FA OTP on the active outbound channel
      description: >
        Generates a fresh CSPRNG 6-digit OTP and resends it on the active outbound channel (`sms`
        or `email`) for the current admin login challenge. Enforces a 60-second cooldown and a
        maximum of 3 outbound sends per login session, plus per-account and per-IP send limits.
      operationId: authResend2fa
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                user_id:
                  type: integer
                challenge_token:
                  type: string
              required: [user_id, challenge_token]
      responses:
        "200":
          description: OTP resent on active channel
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SuccessResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: Outbound channel delivery failed

  /api/v1/auth/2fa/switch-channel:
    post:
      tags: [Auth]
      summary: Switch admin 2FA channel ("Send via email" / "Use authenticator app instead")
      description: >
        Switches an active admin 2FA challenge to another configured channel: `email`
        ("Didn't receive it? Send via email") dispatches a fresh OTP to the admin's email address,
        or `totp` ("Use authenticator app instead") immediately switches the step to authenticator
        app verification without consuming outbound send quota.
      operationId: authSwitch2faChannel
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                user_id:
                  type: integer
                challenge_token:
                  type: string
                channel:
                  type: string
                  enum: [sms, email, totp]
              required: [user_id, challenge_token, channel]
      responses:
        "200":
          description: Channel switched successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SuccessResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: Target outbound channel delivery failed

  /api/v1/auth/password/forgot:
    post:
      tags: [Auth]
      summary: Request SMS-OTP code for password reset
      description: >
        Issues a single-use, purpose-bound (`password_reset`, TTL 300s, max 5 verify attempts)
        6-digit OTP via the existing `auth_2fa` SMS pattern when an unambiguous active account matches.
        Protected by SMS per-phone/per-IP limits and auth attempt limits. Always returns the same
        200 response with equalized timing regardless of whether the phone number exists.
      operationId: authPasswordForgot
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AuthPasswordForgotRequest"
      responses:
        "200":
          description: Uniform acknowledgment (prevents phone enumeration)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          message:
                            type: string
                            example: در صورت وجود حساب کاربری فعال، کد تأیید به شماره موبایل شما ارسال شد.
                          expires_in:
                            type: integer
                            example: 300
                        required: [message, expires_in]
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: OTP service unavailable (Redis offline)

  /api/v1/auth/password/verify:
    post:
      tags: [Auth]
      summary: Verify password-reset SMS OTP and obtain short-lived single-use reset token
      description: >
        Verifies a `password_reset` OTP in Redis (`famo:otp:password_reset:{identifier}`).
        Codes issued for `login_2fa` are rejected. Fails closed (`503`) if Redis is unavailable.
        Returns a signed single-use reset token (TTL 600s).
      operationId: authPasswordVerify
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AuthPasswordVerifyRequest"
      responses:
        "200":
          description: OTP verified; short-lived signed reset token returned
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          reset_token:
                            type: string
                          expires_in:
                            type: integer
                            example: 600
                        required: [reset_token, expires_in]
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: OTP verification service unavailable (fail-closed when Redis is down)

  /api/v1/auth/password/reset:
    post:
      tags: [Auth]
      summary: Reset password using verified single-use reset token
      description: >
        Consumes the single-use `password_reset` token (TTL 10 min), updates `users.password_hash`,
        clears `must_change_password` if present in the schema, and revokes all active JWT sessions
        via `JwtRevocation::revokeAllForUser`. Fails closed (`503`) if Redis is unavailable.
      operationId: authPasswordReset
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AuthPasswordResetRequest"
      responses:
        "200":
          description: Password reset completed and prior JWTs revoked
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          message:
                            type: string
                            example: رمز عبور با موفقیت بازنشانی شد
                        required: [message]
        "401":
          $ref: "#/components/responses/Unauthorized"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"
        "503":
          description: Password reset service unavailable (fail-closed when Redis is down)

  /api/v1/auth/register:
    post:
      tags: [Auth]
      summary: Student self-registration
      operationId: authRegister
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                phone:
                  type: string
                  description: شماره تلفن
                password:
                  type: string
                  format: password
                  minLength: 4
                  description: رمز عبور حساب
                nationalId:
                  type: string
                  description: کد ملی
                grade:
                  type: integer
                  description: پایه تحصیلی
                  enum: [7, 8, 9, 10, 11, 12]
                field:
                  type: string
                  description: رشته تحصیلی
                  enum: [ریاضی, تجربی, انسانی, زبان, هنر, عمومی, راهنمایی]
                name:
                  type: string
                  description: نام و نام خانوادگی
              required: [phone, password, nationalId, grade, field, name]
      responses:
        "201":
          description: Registration successful (returns a JWT — auto login)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          token:
                            type: string
                          user:
                            type: object
                            properties:
                              id:
                                type: integer
                              username:
                                type: string
                              role:
                                type: string
                                enum: [admin, supporter, student, teacher]
                              student_id:
                                type: integer
                                nullable: true
        "409":
          $ref: "#/components/responses/Conflict"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/me:
    get:
      tags: [Auth]
      summary: Get current user from JWT
      operationId: authMe
      security:
        - bearerAuth: []
      responses:
        "200":
          description: Current user data
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/AuthUserProfile"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "404":
          $ref: "#/components/responses/NotFound"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/change-password:
    post:
      tags: [Auth]
      summary: Change current user's password
      description: >
        Verifies `current_password`, updates the user's password hash, revokes all prior JWT
        sessions for the user via Redis epoch (`jwt:user_epoch:{user_id}`), and issues a fresh
        JWT + `Set-Cookie` for the current session (unless `X-Auth-Mode: cookie` omits `token`
        from the JSON body).
      operationId: authChangePassword
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AuthChangePasswordRequest"
      responses:
        "200":
          description: Password changed successfully; prior tokens revoked and fresh session issued
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        type: object
                        properties:
                          message:
                            type: string
                            example: رمز عبور با موفقیت تغییر یافت
                          token:
                            type: string
                            description: Fresh JWT for the current session (omitted when X-Auth-Mode is cookie)
                          user:
                            type: object
                            properties:
                              id:
                                type: integer
                              username:
                                type: string
                              role:
                                type: string
                                enum: [admin, supporter, student, teacher]
                              student_id:
                                type: integer
                                nullable: true
                              instructor_id:
                                type: integer
                                nullable: true
                        required: [message]
        "401":
          description: Unauthorized or wrong current password (INVALID_PASSWORD)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                success: false
                data: null
                pagination: null
                error:
                  code: INVALID_PASSWORD
                  message: رمز عبور فعلی اشتباه است
        "404":
          $ref: "#/components/responses/NotFound"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/profile:
    put:
      tags: [Auth]
      summary: Update current user's profile (full_name and phone, synced with role table)
      description: >
        Updates `full_name` (or `name`) and `phone` (normalized via `PhoneNumber::normalizeOrFail`)
        in `users` and the linked role table (`admins`, `supporters`, `students`, `instructors`)
        within a transaction. If the previous `username` matched the previous `phone`, `username`
        is also synced to the new `phone`. For 2FA roles (`admin`, `supporter`, `teacher`),
        changing `phone` requires `current_password`.
      operationId: authUpdateProfile
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AuthProfileUpdateRequest"
      responses:
        "200":
          description: Updated profile data (same structure as /api/v1/auth/me)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/AuthUserProfile"
        "401":
          description: Unauthorized or wrong current password when changing 2FA phone (INVALID_PASSWORD)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                success: false
                data: null
                pagination: null
                error:
                  code: INVALID_PASSWORD
                  message: رمز عبور فعلی اشتباه است
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          description: Phone number already registered to another user (DUPLICATE_PHONE)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                success: false
                data: null
                pagination: null
                error:
                  code: DUPLICATE_PHONE
                  message: این شماره تلفن قبلاً برای کاربر دیگری ثبت شده است
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/logout:
    post:
      tags: [Auth]
      summary: Logout (clear cookie and blacklist active JWT)
      description: >
        Clears the shared auth cookie and blacklists the presented JWT (`jwt:bl:{jti}`) in Redis
        for its remaining lifetime. Succeeds even if the token is missing or already expired so
        browsers can always clear cookies.
      operationId: authLogout
      responses:
        "200":
          description: Logged out successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SuccessResponse"
        "429":
          $ref: "#/components/responses/RateLimited"

  # ───────────────────── Telegram Login ─────────────────────
  # Public endpoints (no JWT, no bot service key). The Telegram flow only BINDS
  # an identity; it never grants a site session from `verify`. Tickets travel in
  # the request body only and are single-use. See §4 of the design spec.
  /api/v1/auth/telegram/verify:
    post:
      tags: [Auth]
      summary: Verify Telegram Login Widget payload (never returns a session token)
      description: >
        Offline-verifies the Telegram Login Widget payload with
        HMAC-SHA256 over the alphabetically sorted data-check-string
        (`secret_key = SHA256(bot_token)`); the API never calls Telegram.
        For an already-linked account it returns `linked: true` and the bot
        redirect only. For an unlinked account it returns `linked: false` plus a
        single-use ticket. **This endpoint NEVER returns a session token for any
        role.**
      operationId: telegramVerify
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TelegramVerifyRequest"
      responses:
        "200":
          description: >
            Unlinked account (issues a ticket) or already-linked account
            (returns `bot_redirect_url` only). No token is ever returned.
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        oneOf:
                          - $ref: "#/components/schemas/TelegramVerifyUnlinked"
                          - $ref: "#/components/schemas/TelegramVerifyLinked"
        "401":
          $ref: "#/components/responses/TelegramAuthInvalid"
        "409":
          $ref: "#/components/responses/TelegramReplay"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/telegram/register:
    post:
      tags: [Auth]
      summary: Register a new student with a Telegram ticket and link the account
      description: >
        Creates `users` + `students`, inserts the `telegram_links` row
        (`role=student`), atomically consumes the ticket, and returns a JWT.
        Validation is identical to `POST /api/v1/auth/register`.
      operationId: telegramRegister
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TelegramRegisterRequest"
      responses:
        "201":
          description: Registration successful and Telegram account linked (returns a JWT)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/TelegramLinkResult"
        "401":
          $ref: "#/components/responses/TelegramTicketInvalid"
        "409":
          $ref: "#/components/responses/Conflict"
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/telegram/link:
    post:
      tags: [Auth]
      summary: Link an existing account using a Telegram ticket
      description: >
        Authenticates `username`/`password` and links the Telegram account.
        Students receive a JWT immediately. Supporters require 2FA: the link row
        is created only after a successful code; the ticket is validated but not
        consumed until `/verify-2fa`. Errors before successful authentication are
        generic (`AUTH_ERROR`).
      operationId: telegramLink
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TelegramLinkRequest"
      responses:
        "200":
          description: Student linked successfully (returns a JWT)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/TelegramLinkResult"
        "202":
          description: Supporter authenticated — 2FA required (no token, no link yet)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/Telegram2faChallenge"
        "401":
          description: >
            Generic auth failure (`AUTH_ERROR`) or invalid/expired ticket
            (`TELEGRAM_TICKET_INVALID`)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              examples:
                auth_error:
                  value:
                    success: false
                    data: null
                    pagination: null
                    error:
                      code: AUTH_ERROR
                      message: نام کاربری یا رمز عبور اشتباه است
                ticket_invalid:
                  value:
                    success: false
                    data: null
                    pagination: null
                    error:
                      code: TELEGRAM_TICKET_INVALID
                      message: بلیت ورود تلگرام نامعتبر یا منقضی شده است
        "403":
          $ref: "#/components/responses/TelegramLinkRoleUnsupported"
        "409":
          $ref: "#/components/responses/Conflict"
        "429":
          $ref: "#/components/responses/RateLimited"

  /api/v1/auth/telegram/verify-2fa:
    post:
      tags: [Auth]
      summary: Verify the Telegram-flow 2FA code and complete linking
      description: >
        Verifies `code` against the server-bound challenge, inserts the
        `role=supporter` link, consumes ticket + challenge, and returns a JWT.
        `user_id` is **not** accepted as authority; if sent it must match the
        server-bound challenge user.
      operationId: telegramVerify2fa
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TelegramVerify2faRequest"
      responses:
        "200":
          description: 2FA verified, supporter linked (returns a JWT)
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - properties:
                      data:
                        $ref: "#/components/schemas/TelegramLinkResult"
        "401":
          description: >
            Invalid/expired 2FA code (`2FA_ERROR`) or invalid/expired ticket
            (`TELEGRAM_TICKET_INVALID`)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              examples:
                twofa_error:
                  value:
                    success: false
                    data: null
                    pagination: null
                    error:
                      code: 2FA_ERROR
                      message: کد تأیید نامعتبر یا منقضی شده است
                ticket_invalid:
                  value:
                    success: false
                    data: null
                    pagination: null
                    error:
                      code: TELEGRAM_TICKET_INVALID
                      message: بلیت ورود تلگرام نامعتبر یا منقضی شده است
        "409":
          $ref: "#/components/responses/Conflict"
        "429":
          $ref: "#/components/responses/RateLimited"

