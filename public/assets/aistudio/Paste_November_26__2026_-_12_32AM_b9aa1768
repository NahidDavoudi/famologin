          $ref: "#/components/responses/RateLimited"
    post:
      tags: [Public, Testimonials]
      summary: Submit a public testimonial for admin moderation
      description: |
        Accepts a testimonial from the public website and stores it with `status = 'pending'`
        and `source = 'public_form'`.
        - Does not collect phone numbers or persist IP hashes in MySQL.
        - Ignores `course_id`, `instructor_id`, `status`, `is_featured`, and `display_order` (admin links/moderates later).
        - Protected by strict per-IP rate limiting (default 5 submissions/hour), a silent `website` honeypot field,
          and short-TTL (600s) Redis deduplication keyed with server-secret HMAC-SHA256.
      operationId: publicSubmitTestimonial
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PublicTestimonialSubmitRequest"
      responses:
        "201":
          description: Testimonial submitted and queued for moderation
