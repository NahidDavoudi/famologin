          type: array
          nullable: true
          items:
            type: integer
            minimum: 1
          description: Optional subset of student IDs to process; omit to process all eligible students
        operation_id:
          type: string
          nullable: true
          description: Optional client operation/idempotency token to guard against double-click submissions
        body_id:
          type: integer
          nullable: true
          minimum: 1
          description: Optional Melipayamak appointment reminder pattern bodyId override (overrides DB/env for this dispatch)
        save_pattern:
          type: boolean
          default: false
          description: When true alongside body_id, persists body_id in sms_pattern_settings for future dispatches
      required: [week_date, mode]

