      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: VALIDATION_ERROR
              message: نام دانش‌آموز الزامی است
    InternalError:
      description: Internal server error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: INTERNAL_ERROR
              message: خطای داخلی سرور
    BotUnauthorized:
      description: Missing or invalid bot service key
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: BOT_UNAUTHORIZED
              message: کلید سرویس ربات نامعتبر است
    BotForbidden:
      description: Bot IP not allowed, or acting account blocked/inactive
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: BOT_ACCOUNT_BLOCKED
              message: کاربر ربات را مسدود کرده است
    ContentAccessDisabled:
      description: Content-reading permission is off for this admin
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: CONTENT_ACCESS_DISABLED
              message: دسترسی به محتوای پیام‌ها فعال نیست
    RateLimited:
      description: Rate limit exceeded; retry after the indicated delay (`Retry-After` header)
      headers:
        Retry-After:
          schema:
            type: integer
          description: Seconds until the next allowed request
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
          example:
            success: false
            data: null
            pagination: null
            error:
              code: RATE_LIMITED
              message: تعداد درخواست‌ها بیش از حد مجاز است
    TelegramAuthInvalid:
      description: Widget hash invalid, or auth_date stale
      content:
        application/json:
          schema:
