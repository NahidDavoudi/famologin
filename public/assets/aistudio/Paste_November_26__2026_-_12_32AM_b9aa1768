  /api/v1/public/admissions:
    get:
      tags: [Public, Admissions]
      summary: List published admissions / achievers (public, cached 300s)
      description: |
        Returns published and consent-confirmed (`status = 'published' AND consent_confirmed = 1`)
        student admission records for the public website.
        Cached for 300 seconds via `PublicCacheMiddleware(300)` under cache group `public`
        and automatically flushed on any admin admission mutation.
        Supports filtering by Jalali `year`, `exam_type`, `field`, `featured`, and grouping with `group_by=year`.
      operationId: publicListAdmissions
      parameters:
        - name: year
          in: query
          required: false
          description: Filter by Jalali year (1380–1450)
          schema:
            type: integer
            minimum: 1380
            maximum: 1450
        - name: exam_type
          in: query
          required: false
          schema:
            type: string
            enum: [konkur, tizhooshan, nemoone, olympiad, other]
        - name: field
          in: query
          required: false
          schema:
            type: string
            maxLength: 60
        - name: featured
          in: query
          required: false
          schema:
            type: boolean
        - name: group_by
          in: query
          required: false
          description: Set to `year` to return records grouped by Jalali year descending (`groups` array instead of paginated `items`)
          schema:
            type: string
            enum: [year]
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PerPage"
      responses:
        "200":
          description: Published admissions list (paginated or grouped by Jalali year)
          headers:
            X-RateLimit-Limit:
              $ref: "#/components/headers/XRateLimitLimitHeader"
            X-RateLimit-Remaining:
              $ref: "#/components/headers/XRateLimitRemainingHeader"
          content:
            application/json:
              schema:
                allOf:
                  - $ref: "#/components/schemas/SuccessResponse"
                  - type: object
                    properties:
                      data:
                        type: object
                        properties:
                          years:
                            type: array
                            items:
                              type: integer
                            description: Distinct Jalali years with at least one published & consented record
                          items:
                            type: array
                            items:
                              $ref: "#/components/schemas/AdmissionPublic"
                            description: Present when `group_by` is not `year`
                          groups:
                            type: array
                            items:
                              $ref: "#/components/schemas/AdmissionYearGroup"
                            description: Present when `group_by=year`
        "422":
          $ref: "#/components/responses/ValidationError"
        "429":
          $ref: "#/components/responses/RateLimited"

