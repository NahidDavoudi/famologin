components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: JWT token obtained from POST /api/v1/auth/login
    botKey:
      type: apiKey
      in: header
      name: X-Bot-Key
      description: >
        Service key for the external Telegram bot host. Grants access only to
        /api/v1/bot/* endpoints. Completely separate from bearerAuth. An optional
        IP allow-list (BOT_IP_ALLOWLIST) may further restrict callers.

  parameters:
    Page:
      name: page
      in: query
      required: false
      schema:
        type: integer
        default: 1
        minimum: 1
      description: Page number (must be a positive integer >= 1)
    PerPage:
      name: per_page
      in: query
      required: false
      schema:
        type: integer
        default: 20
        minimum: 1
        maximum: 100
      description: Items per page
    PublicPerPage:
      name: per_page
      in: query
      required: false
      schema:
        type: integer
        default: 20
        minimum: 1
        maximum: 50
      description: Items per page for public blog endpoints (integer between 1 and 50; defaults to 20)
    PublicBlogSlug:
      name: slug
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 255
      description: Non-empty URL slug of the published blog post (1..255 characters)
    PublicBlogCategorySlug:
      name: category
      in: path
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 100
      description: Non-empty blog category slug or identifier (1..100 characters)
    PerPageAlt:
      name: perPage
      in: query
      schema:
        type: integer
        default: 20
        minimum: 1
      description: Items per page (alternate casing)
    BotRole:
      name: X-Bot-Role
      in: header
      required: true
      schema:
        type: string
        enum: [student, supporter]
      description: Acting role for the linked Telegram account
    TelegramUserId:
      name: X-Telegram-User-Id
      in: header
      required: true
      schema:
        type: string
      description: Telegram numeric user id
    TelegramChatId:
      name: X-Telegram-Chat-Id
      in: header
      required: true
      schema:
        type: string
      description: Telegram numeric chat id (must match the stored link)
    StudentIdPath:
      name: studentId
      in: path
      required: true
      schema:
        type: integer
      description: Student id
    DateFrom:
      name: from
      in: query
      schema:
        type: string
        format: date
      description: Start Tehran date (inclusive)
    DateTo:
      name: to
      in: query
      schema:
        type: string
        format: date
      description: End Tehran date (inclusive)

  headers:
    XCacheHeader:
      description: Redis public response cache status (`HIT` when served from Redis cache, `MISS` when computed fresh)
      schema:
        type: string
        enum: [HIT, MISS]
    PublicCacheControlHeader:
      description: HTTP cache control policy for public endpoints (`public, max-age=300`)
      schema:
        type: string
        example: "public, max-age=300"
    XRateLimitLimitHeader:
      description: Maximum allowed requests per client IP within the rate-limit window (`PUBLIC_RATE_LIMIT_MAX_ATTEMPTS`, default 60)
      schema:
        type: integer
        example: 60
    XRateLimitRemainingHeader:
      description: Remaining allowed requests for the client IP in the current window
      schema:
        type: integer
        minimum: 0
        example: 59

  requestBodies:
    BotBlockRequest:
      required: true
      content:
        application/json:
          schema:
            type: object
            properties:
              telegram_user_id:
                type: integer
                format: int64
              chat_id:
                type: integer
                format: int64
              role:
                type: string
                enum: [student, supporter]
            description: Provide telegram_user_id (optionally with role) or chat_id

  schemas:
    # ──── Envelope ────
    SuccessResponse:
      type: object
      properties:
        success:
          type: boolean
          enum: [true]
        data:
          nullable: true
        pagination:
          anyOf:
            - $ref: "#/components/schemas/Pagination"
            - type: "null"
        error:
          type: "null"
      required: [success, data, pagination, error]

    ErrorResponse:
      type: object
      properties:
        success:
          type: boolean
          enum: [false]
        data:
          type: "null"
        pagination:
          type: "null"
        error:
          type: object
          properties:
            code:
              type: string
              description: Error code (machine-readable)
            message:
              type: string
              description: Human-readable error message in Persian
          required: [code, message]
      required: [success, data, pagination, error]

    Pagination:
      type: object
      properties:
        page:
          type: integer
        per_page:
          type: integer
        total:
          type: integer
        total_pages:
          type: integer
        sort:
          type: string
          description: Active resolved sort key (included when sort or order query parameters are provided)
        order:
          type: string
          enum: [asc, desc]
          description: Active resolved sort direction (included when sort or order query parameters are provided)
      required: [page, per_page, total, total_pages]

    WithPagination:
      properties:
        pagination:
          $ref: "#/components/schemas/Pagination"

    # ──── Domain Models ────
    Student:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
        phone:
          type: string
        grade:
          type: integer
        field:
          type: string
        national_id:
          type: string
        status:
          type: integer
          enum: [0, 1]
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time

    ParentContact:
      type: object
      properties:
        id:
          type: integer
        student_id:
          type: integer
        parent_name:
          type: string
        relationship:
          type: string
          enum: [father, mother, guardian, other]
        phone:
          type: string
          maxLength: 15
        is_primary:
          type: boolean
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
      required: [id, student_id, parent_name, relationship, phone, is_primary]

    ParentContactInput:
      type: object
      properties:
        parent_name:
          type: string
          description: نام والد یا سرپرست
        relationship:
          type: string
          enum: [father, mother, guardian, other]
        phone:
          type: string
          maxLength: 15
        is_primary:
          type: boolean
          description: فقط یک مخاطب اصلی برای هر دانش‌آموز مجاز است
      required: [parent_name, relationship, phone]

    Course:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
        icon:
          type: string
          nullable: true
        gradient_color_from:
          type: string
          nullable: true
        gradient_color_to:
          type: string
          nullable: true
        background_image_url:
          type: string
          nullable: true
        description:
          type: string
          nullable: true
        full_description:
          type: string
          nullable: true
        target_grades:
          type: string
          nullable: true
        format:
          type: string
          nullable: true
        badge_label:
          type: string
          nullable: true
        price:
          type: integer
        display_order:
          type: integer
        features:
          type: array
          items:
